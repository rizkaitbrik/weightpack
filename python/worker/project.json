{
  "name": "worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "python/worker/weightpack_worker",
  "targets": {
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "publish": true,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      },
      "cache": true
    },
    "lint": {
      "executor": "@nxlv/python:ruff-check",
      "outputs": [],
      "options": {
        "lintFilePatterns": ["weightpack_worker", "tests"]
      },
      "cache": true
    },
    "format": {
      "executor": "@nxlv/python:ruff-format",
      "outputs": [],
      "options": {
        "filePatterns": ["weightpack_worker", "tests"]
      },
      "cache": true
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/{projectRoot}/unittests",
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "uv run pytest tests/",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "dependsOn": [
        {
          "projects": ["wpk", "wpkd"],
          "target": "build"
        }
      ]
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "verbose": false,
        "debug": false
      }
    },
    "nx-release-publish": {
      "executor": "@nxlv/python:publish",
      "options": {},
      "outputs": []
    },
    "parity": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run --group parity pytest tests/test_peft_parity.py tests/test_engine.py tests/test_e2e_serve.py -s --no-cov",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": ["wpk", "wpkd"],
          "target": "build"
        }
      ]
    },
    "smoke": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "WPK_SMOKE=1 uv run --group parity pytest tests/test_smoke_real_model.py -s --no-cov",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": ["wpk", "wpkd"],
          "target": "build"
        }
      ]
    },
    "gate": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "WPK_GATE=1 uv run --group parity pytest tests/test_router_gate.py -s --no-cov",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": ["wpk", "wpkd"],
          "target": "build"
        }
      ]
    },
    "import-gate": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "WPK_IMPORT_GATE=1 uv run --group parity pytest tests/test_import_gate.py -s --no-cov",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": ["wpk", "wpkd"],
          "target": "build"
        }
      ]
    }
  },
  "tags": ["lang:python", "type:lib"],
  "release": {
    "version": {
      "versionActions": "@nxlv/python/release/version-actions"
    }
  }
}
